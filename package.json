{
  "name": "next-clean-restart",
  "displayName": "Next.js Clean Restart",
  "description": "One-click button and sidebar tab to stop Next.js, purge .next build cache, and restart a fresh dev server in the active terminal.",
  "version": "1.2.0",
  "publisher": "Eugee29",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eugee29/next-clean-restart"
  },
  "bugs": {
    "url": "https://github.com/Eugee29/next-clean-restart/issues"
  },
  "homepage": "https://github.com/Eugee29/next-clean-restart#readme",
  "icon": "icon.png",
  "keywords": [
    "next.js",
    "nextjs",
    "next",
    "clean",
    "cache",
    "restart",
    "dev server",
    "turbopack"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/next.config.js",
    "workspaceContains:**/next.config.mjs",
    "workspaceContains:**/next.config.ts",
    "workspaceContains:**/next.config.cjs",
    "workspaceContains:**/package.json",
    "onView:nextCleanRestart.mainView",
    "onCommand:nextCleanRestart.cleanRestart",
    "onCommand:nextCleanRestart.cleanOnly",
    "onCommand:nextCleanRestart.restartOnly"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nextCleanRestart",
          "title": "Next.js Clean Restart",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "views": {
      "nextCleanRestart": [
        {
          "id": "nextCleanRestart.mainView",
          "name": "Next.js Clean Restart"
        }
      ]
    },
    "commands": [
      {
        "command": "nextCleanRestart.cleanRestart",
        "title": "Next.js: Clean & Restart Dev Server",
        "category": "Next.js",
        "icon": "$(sync)"
      },
      {
        "command": "nextCleanRestart.cleanOnly",
        "title": "Next.js: Clean .next Cache Only",
        "category": "Next.js",
        "icon": "$(trash)"
      },
      {
        "command": "nextCleanRestart.restartOnly",
        "title": "Next.js: Restart Dev Server Only",
        "category": "Next.js",
        "icon": "$(refresh)"
      },
      {
        "command": "nextCleanRestart.focusTerminal",
        "title": "Next.js: Focus Dev Terminal",
        "category": "Next.js",
        "icon": "$(terminal)"
      },
      {
        "command": "nextCleanRestart.configureKeybinding",
        "title": "Next.js: Configure Keyboard Shortcuts",
        "category": "Next.js",
        "icon": "$(keyboard)"
      },
      {
        "command": "nextCleanRestart.selectActiveTerminal",
        "title": "Next.js: Select Target Terminal",
        "category": "Next.js",
        "icon": "$(terminal)"
      },
      {
        "command": "nextCleanRestart.refreshSidebar",
        "title": "Refresh Next.js Projects & Settings",
        "category": "Next.js",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "nextCleanRestart.cleanRestart",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "nextCleanRestart:isNextProject"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nextCleanRestart.cleanRestart"
        },
        {
          "command": "nextCleanRestart.cleanOnly"
        },
        {
          "command": "nextCleanRestart.restartOnly"
        },
        {
          "command": "nextCleanRestart.focusTerminal"
        },
        {
          "command": "nextCleanRestart.configureKeybinding"
        },
        {
          "command": "nextCleanRestart.selectActiveTerminal"
        }
      ],
      "view/title": [
        {
          "command": "nextCleanRestart.cleanRestart",
          "when": "view == nextCleanRestart.mainView",
          "group": "navigation@1"
        },
        {
          "command": "nextCleanRestart.refreshSidebar",
          "when": "view == nextCleanRestart.mainView",
          "group": "navigation@2"
        }
      ],
      "editor/title/run": [
        {
          "command": "nextCleanRestart.cleanRestart",
          "group": "navigation",
          "when": "nextCleanRestart:isNextProject"
        }
      ]
    },
    "configuration": {
      "title": "Next.js Clean Restart",
      "properties": {
        "nextCleanRestart.terminalName": {
          "type": "string",
          "default": "auto",
          "description": "Name of the target integrated terminal, or 'auto' to automatically detect the currently active terminal or running Next.js process."
        },
        "nextCleanRestart.reuseTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Reuse the existing running integrated terminal instead of creating a new terminal tab on each restart."
        },
        "nextCleanRestart.devCommand": {
          "type": "string",
          "default": "auto",
          "description": "Custom command to start Next.js development server. Set to 'auto' to auto-detect based on package manager (pnpm, yarn, bun, or npm)."
        },
        "nextCleanRestart.showConfirmation": {
          "type": "boolean",
          "default": false,
          "description": "Prompt for confirmation before clearing the .next cache and restarting."
        },
        "nextCleanRestart.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Whether to display the Next.js Clean Restart button on the status bar."
        },
        "nextCleanRestart.cacheDirectory": {
          "type": "string",
          "default": ".next",
          "description": "Relative path to the Next.js build cache directory to remove."
        },
        "nextCleanRestart.retryAttempts": {
          "type": "number",
          "default": 5,
          "description": "Number of retry attempts when encountering file lock errors during cache deletion (especially on Windows)."
        },
        "nextCleanRestart.retryDelayMs": {
          "type": "number",
          "default": 300,
          "description": "Delay in milliseconds between cache deletion retry attempts."
        },
        "nextCleanRestart.focusTerminalOnStart": {
          "type": "boolean",
          "default": false,
          "description": "Whether to bring the terminal into focus when restarting the dev server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "package": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "test": "node ./dist-test/test/detector.test.js",
    "test:compile": "tsc -p ./tsconfig.test.json && npm test"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.1",
    "typescript": "^5.3.3"
  }
}
